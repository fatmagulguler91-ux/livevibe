rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      // Kullanıcı kendi profilini güncelleyebilir AMA coinBalance alanını
      // DEĞİŞTİREMEZ - bu alan sadece Cloud Functions (admin SDK ile) yazabilir.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['coinBalance']);
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null
                          && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.senderId;
      }
    }

    // Coin satın alma ve hediye kayıtları SADECE Cloud Functions tarafından
    // yazılır (Admin SDK, security rules'ı bypass eder). Client bu koleksiyonlara
    // hiçbir şekilde direkt yazamaz - sadece kendi geçmişini okuyabilir.
    match /coinPurchases/{purchaseId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /giftTransactions/{transactionId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.fromUserId
                      || request.auth.uid == resource.data.toUserId);
      allow write: if false;
    }
  }
}
